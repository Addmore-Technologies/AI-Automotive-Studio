# AI Automotive Studio Backend Environment Configuration
APP_NAME="AI Automotive Studio API"
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,*

# File Size Limits (bytes)
MAX_IMAGE_SIZE_BYTES=26214400 # 25 MB
MAX_VIDEO_SIZE_BYTES=104857600 # 100 MB

# Plate replacement defaults
DEFAULT_PLATE_TEXT="STUDIO 01"
DEFAULT_PLATE_SUBTEXT="AUTO-AI"
